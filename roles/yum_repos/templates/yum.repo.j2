#jinja2: trim_blocks:True, lstrip_blocks: True
#
# Config file generated with yum_repos role from the league-of-robots repository.
# Do not modify manually; update the variables or code and redeploy with Ansible instead.
#
[{{ yum_repo['id'] }}]
name={{ yum_repo['name'] | default(yum_repo['id']) }}
enabled={{ yum_repo['enabled'] | default(1) }}
enabled_metadata={{ yum_repo['enabled'] | default(1) }}
metadata_expire=86400
{% if repo_manager is defined and repo_manager == 'mirror' %}
baseurl={% for server in global_repo_servers %}https://{{ server.name }}:8443/{{ stack_prefix }}/{{ yum_repo['id'] }}/  {% endfor %}

{% else %}
{% if yum_repo['baseurl'] is defined %}
baseurl={{ yum_repo['baseurl'] }}
{% endif %}
{% if yum_repo['mirrorlist'] is defined %}
mirrorlist={{ yum_repo['mirrorlist'] }}
{% endif %}
{% if yum_repo['metalink'] is defined %}
metalink={{ yum_repo['metalink'] }}
{% endif %}
{% endif %}
{% if yum_repo['gpgcheck'] | default(1) == 1 %}
gpgcheck=1
  {% if yum_repo['gpgkeysource'] is defined %}
gpgkey=file://{{ yum_repos_gpgkeys_dir }}/{{ yum_repo['gpgkeysource'] | basename }}
  {% else  %}
gpgkey={{ yum_repo['gpgkey'] }}
  {% endif %}
{% else %}
gpgcheck=0
{% endif %}
{% if yum_repo['countme'] is defined %}
countme={{ yum_repo['countme'] }}
{% endif %}
