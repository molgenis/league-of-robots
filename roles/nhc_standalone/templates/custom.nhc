# Initialize variables
declare USERS="${1:-root,umcg-atd-dm,umcg-atd-ateambot}"
declare LOOKBACK_MIN="${2:-15}"
declare PROCESS="${3:-CROND}"

#function check_journalctl () USERLIST LOOKBACKTIME PROCESSNAME PATTERNLIST
function check_journalctl()
{
	# CONFIG Defaults
	local USERS="${1:-root,umcg-atd-dm,umcg-atd-ateambot}"
	local LOOKBACK_MIN="${2:-15}"
	local PROCESS="${3:-CROND}"
	local PATTERN="${4:-FAILED|status=[1-9]|exit code|segfault}"

	local USER
	local USER_LOGS
	local MATCH
	local SINCE
	local LOGS
	local WARNING

	local -a USER_LIST
	local -a ERRORS=()

	IFS=',' read -r -a USER_LIST <<< "${USERS}"

	SINCE="$(date -d "-${LOOKBACK_MIN} min" "+%Y-%m-%d %H:%M:%S")"

	#die 1 "$FUNCNAME:  journalctl --since ${SINCE} -t ${PROCESS}"
	# FETCH LOGS (TO DO: MAKE It work with -t)
	LOGS="$(
		journalctl \
			--since "${SINCE}" \
			-g "${PROCESS}" \
			--no-pager 2>/dev/null | grep "${PROCESS}" ||
		true
	)"

	for USER in "${USER_LIST[@]}"; do

		# Only cron execution lines for this user
		USER_LOGS="$(
			printf '%s\n' "${LOGS}" |
			grep "(${USER})" |
			grep "CMD" ||
			true
		)"

		if [[ -n "${USER_LOGS}" ]]; then

			MATCH="$(
				printf '%s\n' "${USER_LOGS}" |
				grep -iE "${PATTERN}" ||
				true
			)"

			if [[ -n "${MATCH}" ]]; then
				ERRORS+=("${USER}: $(printf '%s\n' "${MATCH}" | head -n1)")
			fi
		fi
	done

	# Create warning message
	if [[ ${#ERRORS[@]} -gt 0 ]]; then


	WARNING="$FUNCNAME:  CRON_ERRORS detected in last ${LOOKBACK_MIN} min"
	log $WARNING
	WARNING="${WARNING};  Affected user: ${USER}"

	for MATCH in "${ERRORS[@]}"; do
		WARNING="${WARNING}; ${MATCH}"
	done
	log "${WARNING}"
	die 1 "${WARNING}"

		return 1
	fi

	die 1 "$FUNCNAME:  CRON_OK: no errors detected in last ${LOOKBACK_MIN} min"

	return 0
}
