# NHC -- UMCG's check for journalctl patterns

# Initialize variables
declare USERS="${1:-root}"
declare LOOKBACK_MIN="${2:-15}"
declare TAG="${3:-CROND}"
declare PATTERN="${4:-FAILED|status=[1-9]|exit code|segfault|fail|error}"

# Check journalctl entries for a given service within a configurable lookback period,
# filtering by tag (-t), error pattern (-g PATTERN), and user list.
# Report matching entries as an NHC health check.
#
# Behaviour:
# FAILED: A matching error pattern is found within the configured time window.
# OK: No matching error pattern is found found within the configured time window.
#
# An 'CLEARED' notification does not 100% guarantee that a process runs 'OK' again;
# it means that no matching log entries were found in the given lookback period.
# Therefore, make sure the `lookback_min` matches the run freqency of your check.
function check_journalctl()
{
    # Defaults
    local USER=${1:-} # can be empty, will match all
    local LOOKBACK_MIN="${2:-15}"
    local TAG="${3:-CROND}"
    local PATTERNS="${4:-FAILED|status=[1-9]|exit code|segfault|fail|error}"

    local MATCH
    local SINCE
    local LOGS
    local WARNING

    local -a ERRORS=()

    # Fetch Logs for a specific TAG and a PATTERN
    LOGS="$(
    journalctl \
        --since "${LOOKBACK_MIN} min ago" \
        -t "${TAG}" -g "${USER}" \
        --case-sensitive=no \
        --no-pager 2>/dev/null || true
    )"
    # Look for all PATTERNS in ${LOGS}
    USER_LOGS=$(grep -iE "(${PATTERNS})" <<< "${LOGS}" || true)
    UNIQUE_CLEAN_LOGS="$(sed 's/^.*://g' <<< "${USER_LOGS}" | uniq)"

    # Report $WARNING to logfile using 'die 1'
    if [[ -n "${UNIQUE_CLEAN_LOGS}" ]]; then

      for UNIQUE_ERROR in "${UNIQUE_CLEAN_LOGS}"; do
         WARNING="${FUNCNAME}_${TAG}: ERROR - ${LOOKBACK_MIN}min (${USER}) ${UNIQUE_ERROR}"
      done

      die 1 "${WARNING}"
      return 1
    fi

    # reporting if 'OK and return 0'
    log "${FUNCNAME}_${TAG}:  OK - no errors detected in last ${LOOKBACK_MIN} min"
    return 0
}

function check_systemctl_running() {
   local SERVICE=${1:-}
   if -z ${SERVICE}; then
     return 0
   else
     if systemctl is-active --quiet ${SERVICE}; then
        log "${FUNCNAME}_${SERVICE} -  OK service is running"
        return 0
     else
        systemctl restart --no-block --quiet ${SERVICE}
        die 1 "${FUNCNAME}_${SERVICE} - ERROR service is not running, sent restart request ..."
     fi
   fi
}
