server {
    listen 8443 ssl http2;
    server_name {{ inventory_hostname }};

    ssl_certificate     {{ nginx_ssl_dir }}/{{ inventory_hostname }}.crt;
    ssl_certificate_key {{ nginx_ssl_dir }}/{{ inventory_hostname }}.key;

    ssl_prefer_server_ciphers on;

    root {{ main_repo_path }}/2deploy;
    index index.html;

    location / {
        autoindex on;
        try_files $uri $uri/ =404;
    }
}
