#!/bin/bash
set -euo pipefail

{%- set filtered_mounts = lfs_mounts | selectattr('lfs', 'match', '^(prm|tmp|arc|rsc)0[0-9]+$') | list %}
{%- set unique_pfs = filtered_mounts | map(attribute='pfs') | map('regex_replace', '\\$$', '') | map('regex_replace', '/', '_') | unique | list %}

# All unique pfs values
_pfs_list=(
{%- for pfs in unique_pfs %}
  "{{ pfs }}"
{%- endfor %}
)

# All lfs values per pfs, space-separated
declare -A _lfs_by_pfs
{% for pfs in unique_pfs %}
_lfs_by_pfs["{{ pfs }}"]="
  {%- for item in filtered_mounts %}
    {%- set pfs_clean = item.pfs | regex_replace('\\$$', '') | regex_replace('/', '_') %}
    {%- if pfs_clean == pfs %}{{ item.lfs }} {% endif %}
  {%- endfor %}"
{%- endfor %}

{% raw %}
# For now only groups starting with 'L-'
_all_groups="$(getent group 2>/dev/null | awk -F':' '{print $1}' | grep -E "(^L-)")"
_main_groups="$(grep -xE "^L-[^-]+" <<< "${_all_groups}")"
_all_groups_sorted="$(sort -V -u <<< "${_all_groups}")"

for _main_group in ${_main_groups}; do
   # Iterate over all pfs, then all lfs per pfs
   for pfs in "${_pfs_list[@]}"; do
      for lfs in ${_lfs_by_pfs["${pfs}"]}; do
         #Check if main group exists
         _main_group_path="/groups/${_main_group}/${lfs}"
         if ! test -d "${_main_group_path}"; then
            echo "main: missing folder ${_main_group_path}"
            continue
         fi
         if  [[ "$(stat -c '%U:%G' ${_main_group_path}/${_subgrp_type})" != "${_main_group}-dm:${_main_group}" ]]; then
            echo "main: change "${_main_group_path}" ownership to ${_main_group}-dm:${_main_group}"
            chown "${_main_group}-dm:${_main_group}" "${_main_group_path}"
         fi
         # make sure top subfolders exist in main group
         # for _subgrp_type in "rel:releases" "prj:projects" "sub:subgroups"; do
         #    local _each_short="${_subgrp_type%%\:*}"
         #    local _each_long="${_subgrp_type##*\:}"
         for _subgrp_type in "rel" "prj" "sub"; do
            if ! getent group "${_main_group}-${_subgrp_type}" &>/dev/null; then
               test -d "${_main_group_path}/${_subgrp_type}" && continue
               echo "  subdir: creating directory ${_main_group_path}/${_subgrp_type}"
               mkdir "${_main_group_path}/${_subgrp_type}"
            fi
            if  [[ "$(stat -c '%U:%G' ${_main_group_path}/${_subgrp_type})" != "${_main_group}-dm:${_main_group}" ]]; then
               echo "  subdir: change ${_main_group_path}/${_subgrp_type} ownership to ${_main_group}-dm:${_main_group}"
               chown "${_main_group}-dm:${_main_group}" "${_main_group_path}/${_subgrp_type}"
            fi
         done
         # install -d "${_main_group_path}" -o root -g "${_main_group}" -m 0770

         # Now create all the rest of the groups
         for _each_group in ${_all_groups_sorted}; do
            #echo Making sub group
            [[ "${_each_group}" == "${_main_group}" ]] && continue # skip main groups
            # continue subgroups
            if [[ "${_each_group}" =~ ^"${_main_group}" ]]; then
               _group_name="${_each_group##*-}"
               [[ "${_group_name}" == "dms" ]] && continue # skip dms groups
               _group_remove_main_group="${_each_group/${_main_group}-}" # remove /L-mains-/    keep sub
               _group_top_path="${_group_remove_main_group//-/\/}"    # replace - with 	/
                test -d "${_main_group_path}/sub/${_group_top_path}" && continue
               echo "    hier: creating ${_main_group_path}/sub/${_group_top_path}/"
               mkdir "${_main_group_path}/sub/${_group_top_path}" 
               if  [[ "$(stat -c '%U:%G' "${_main_group_path}/sub/${_group_top_path}")" != "${_main_group}-dm:${_main_group}" ]]; then
                  echo "   sub: change ${_main_group_path}/sub/${_group_top_path} ownership to ${_main_group}-dm:${_main_group}"
               owned by ${_main_group}-dm:${_each_group} (0770)"
               # install -d "${_main_group_path}/${_group_top_path}" -o "${_main_group}-dm" -g "${_each_group}" -m "0770"
            fi
         done


      done
   done
done
{% endraw %}
