#jinja2: trim_blocks:True, lstrip_blocks: True
#!/bin/bash

set -ueo pipefail
_main="{{ main_repo_path }}"
mountpoint -q "${_main}" || { echo "${_main} not mounted" >&2; exit 1; }

{% raw %}
! test -d "${_main}/0cache" && mkdir "${_main}/0cache"
! test -d "${_main}/logs/cli" && mkdir "${_main}/logs/cli"

print_all_repos() {
   echo ""
   echo "Available [operating systems] [repositories] options are"
   cd "${_main}/dnf/repos.d/"
   grep '\[.*\]' */*.repo | tr ':' '/' | tr -d '[]' | cut -d'/' -f 1,3 --output-delimiter=" " | sort -u
}

if [[ -z "${1:-}" ]]; then
      echo "Error, you did not provide distribution!"
      print_all_repos
      echo ""
      echo "Correct syntax for downloading the specific repository is"
      echo "  ${0} [os_distribution] [repository]"
      echo "or to download ALL repositories of a specific OS distribution"
      echo "  ${0} [os_distribution]"
      exit
fi

_os_distribution=${1}
_do_repos=${2:-}
_time="$(date +%Y%m%d-%H%M%S)"

## A bit of logging
echo "${_time} running ${0} ${*}" >> "${_main}/logs/cli/$(basename ${0}).log"
echo "    current versions are:" >> "${_main}/logs/cli/$(basename ${0}).log"
ls -Rl 1versions/ | sed 's/^/        /g' >> "${_main}/logs/cli/$(basename ${0}).log"

if [[ -z "${_do_repos:-}" ]]; then
   _do_repos="$(grep -h "\[.*\]" "${_main}/dnf/repos.d/${_os_distribution}/"*.repo | tr -d '[]' | sort -u)"
fi

for _repo in ${_do_repos}; do
   echo ""
   _repo_log_dir="${_main}/logs/scripts/${_os_distribution}/${_repo}"
   ! test -d "${_repo_log_dir}" && mkdir -p "${_repo_log_dir}"
   _repo_log="${_repo_log_dir}/${_time}"
   echo "- Log file: ${_repo_log}"
   if ! dnf reposync --conf "${_main}/dnf/repos.d/${_os_distribution}.conf" --repo "${_repo}" --downloaddir="${_main}/0cache/${_os_distribution}/" --download-metadata 1>"${_repo_log}" 2>&1; then
      echo "  Error, unsuccessfull"
      continue
   fi
   mkdir -p "${_main}/1versions/${_os_distribution}/${_repo}/"
   cp -a --reflink=always "${_main}/0cache/${_os_distribution}/${_repo}/" "${_main}/1versions/${_os_distribution}/${_repo}/${_time}/" || exit
   echo "  New version created:   ${_main}/1versions/${_os_distribution}/${_repo}/${_time}"
done

echo "done"
{% endraw %}
