#jinja2: trim_blocks:True, lstrip_blocks: True
#!/bin/bash

set -ueo pipefail
_main="{{ main_repo_path }}"
mountpoint -q "${_main}" || { echo "${_main} not mounted" >&2; exit 1; }
cd "${_main}"

_lock="/tmp/repo_download.lock"
exec 171>"${_lock}"
flock -n 171 || { echo "Sync already running" >&2; exit 1; }

{% raw %}
! test -d "${_main}/0cache" && mkdir "${_main}/0cache"
! test -d "${_main}/1versions" && mkdir "${_main}/1versions"`
! test -d "${_main}/logs/cli" && mkdir "${_main}/logs/cli"

print_all_repos() {
   echo ""
   echo "Available [operating systems] [repositories] options are"
   cd "${_main}/dnf/repos.d/"
   grep '\[.*\]' */*.repo | tr ':' '/' | tr -d '[]' | cut -d'/' -f 1,3 --output-delimiter=" " | sort -u
}

function help(){
      echo "Error, you did not provide distribution!"
      print_all_repos
      echo ""
      echo "  ${0} [ -d string [ -r string ] ] | [ -0 ]"
      echo ""
      echo "Correct syntax for downloading the specific repository is"
      echo "  ${0} -d os_distribution -r repository"
      echo ""
      echo "or to download ALL repositories of a specific OS distribution"
      echo "  ${0} -d os_distribution"
      echo ""
      echo "or to Automatically detect All existing distributions and repositories and"
      echo "download latest version into cache, but do NOT CREATE VERSION, use"
      echo "  ${0} -0"
      echo ""
      exit
}

if [[ -z "${1:-}" ]]; then
   help
fi

_cache_only=false
_errors=""
OPTSTRING=":d:r:0"
while getopts ${OPTSTRING} opt; do
  case ${opt} in
    d) _do_os_distribution=${OPTARG} && echo "distribution: ${OPTARG}" ;;
    r) _do_repos=${OPTARG} && echo "repository: ${OPTARG}" ;;
    0) _cache_only=true && echo "downloading cache only - NO VERSIONING" ;;
    *) help ;;
  esac
done

# Check is options make sense
if ${_cache_only}; then
   # -0 is not compatible with -d or -r
   if [[ -n "${_do_os_distribution}" || -n "${_do_repos}" ]]; then
      echo "Error: -0 cannot be combined with -d or -r" >&2
      help
   fi
else
   # make sure there is distribution when not only downloading
   if [[ -z "${_do_os_distribution}" ]]; then
      echo "Error: -d [distribution] is required (also when using -r)" >&2
      help
   fi
   # make sure the distribution is valid
   if [[ ! -d "${_main}/dnf/repos.d/${_do_os_distribution}" ]]; then
      echo "Error: unknown distribution '${_do_os_distribution}'" >&2
      print_all_repos
      exit 1
   fi
fi

# Make a timestamp to be used for all new versions
_time="$(date +%Y%m%d-%H%M%S)"

## A bit of logging
echo "${_time} running ${0} ${*}" >> "${_main}/logs/cli/$(basename ${0}).log"
echo "    current versions are:" >> "${_main}/logs/cli/$(basename ${0}).log"
find 1versions/ -maxdepth 3 -type d | sed 's/^/        /g' >> "${_main}/logs/cli/$(basename ${0}).log"

# $1 distribution
# $2 repository
function _download_and_version(){
   local _rc=0
   local _repo_log_dir="${_main}/logs/scripts/${1}/${2}"
   local _repo_log="${_repo_log_dir}/${_time}"
   ! test -d "${_repo_log_dir}" && mkdir -p "${_repo_log_dir}"
   echo "- Log file: ${_repo_log}"

   # Skip stale cache directories if .repo files were removed
   if ! grep -qsF "[${2}]" "${_main}/dnf/repos.d/${1}/"*.repo; then
      echo "  Skipping: ${1}/${2} has no .repo files"
      return 0
    fi

   if dnf reposync \
         --conf "${_main}/dnf/repos.d/${1}.conf" \
         --repo "${2}" \
         --downloaddir="${_main}/0cache/${1}/" \
         --download-metadata \
         1>"${_repo_log}" 2>&1; then
      : # cannot use the ! as the rc becomes 0, so we use true here
   else
      _errors="$(echo -e "${_errors}\n${1} ${2} returned ${?}")"
      echo "  Error, unsuccessfull"
      return 0
   fi
   
   ${_cache_only} && return 0 ## if only caching, don't make version

   # Versioning from here onward
   mkdir -p "${_main}/1versions/${1}/${2}/"

   # make sure the hardlink is actually created, or report error
   if ! cp -a --reflink=always "${_main}/0cache/${1}/${2}/" "${_main}/1versions/${1}/${2}/${_time}/"; then
      rm -rf -- "${_main}/1versions/${1}/${2}/${_time}/"
      echo "  Error, creating version failed"
      _errors+=$'\n'"${1} ${2} version creation failed"
      return 0 # but keep on working with other
   fi
   cp -a --reflink=always "${_main}/0cache/${1}/${2}/" "${_main}/1versions/${1}/${2}/${_time}/" || exit
   echo "  New version created:   ${_main}/1versions/${1}/${2}/${_time}"
}

if ${_cache_only}; then
   for _each_distro in $(find "${_main}/0cache/" -mindepth 1 -maxdepth 1 -type d -printf '%P '); do
      for _each_repo in $(find "${_main}/0cache/${_each_distro}" -mindepth 1 -maxdepth 1 -type d -printf '%P '); do
         _download_and_version "${_each_distro}" "${_each_repo}"
      done
   done
else
   if [[ -z "${_do_repos:-}" ]]; then
      _do_repos="$(grep -h "\[.*\]" "${_main}/dnf/repos.d/${_do_os_distribution}/"*.repo | tr -d '[]' | sort -u)"
   fi
   for _each_repository in ${_do_repos}; do
      _download_and_version "${_do_os_distribution}" "${_each_repository}"
   done
fi

if [[ -n "${_errors}" ]]; then
   echo -e "Errors occured:\n${_errors}"
   exit 1
else
   echo "Successfully finished download cache."
fi
{% endraw %}
