#jinja2: trim_blocks:True, lstrip_blocks: True
{% if inventory_hostname in groups['chaperone'] | default([]) %}
### /etc/hosts-LoR
#    - This file is generated next to /etc/hosts to provide a list of additional
#      hosts and their IP addresses.
#    - File is created on the machines that are not fully managed by
#      league-of-robots playbooks
#    - Used for establishing secure connection to trusted remote servers
{% else %}
### /etc/hosts
{% endif %}

### Generated automatically by Ansible
### with league-of-robots/roles/static_hostname_lookup role.
### Do NOT edit manually: changes will be lost!

#
# localhost
#
127.0.0.1   localhost localhost.localdomain localhost4 localhost4.localdomain4{% if groups['irods'] is defined and inventory_hostname in groups['irods'] %} {{ hostvars[inventory_hostname]['fqdn'] | regex_replace('\..*$', '')}}.localdomain{% endif +%}
::1         localhost localhost.localdomain localhost6 localhost6.localdomain6

#
# Stack {{ stack_name }} hosts.
#
{% set this_host_network_names = host_networks
    | default([])
    | map(attribute='name')
    | flatten
    | unique %}
{% for stack_host in groups['all'] %}
  {% for network in this_host_network_names %}
    {% if hostvars[stack_host]['host_networks']
          | default([])
          | selectattr('name', 'equalto', network)
          | first is defined
       and ip_addresses[stack_host][network] is defined %}
      {% set stack_host_network = hostvars[stack_host]['host_networks']
          | selectattr('name', 'equalto', network)
          | first %}
      {% if ip_addresses[stack_host][network]['fqdn'] is defined
         and stack_host_network['add_hostname_to_ip_address'] | default(false) | bool %}
{{ "%-15s" | format(ip_addresses[stack_host][network]['address']) }}    {{ ip_addresses[stack_host][network]['fqdn'] }}    {{ ip_addresses[stack_host][network]['fqdn'] | regex_replace('\..*$', '')}}    {{ stack_host }}    {{ stack_host }}_{{ network }}
      {% elif ip_addresses[stack_host][network]['fqdn'] is defined
         and not stack_host_network['add_hostname_to_ip_address'] | default(false) | bool %}
{{ "%-15s" | format(ip_addresses[stack_host][network]['address']) }}    {{ ip_addresses[stack_host][network]['fqdn'] }}    {{ ip_addresses[stack_host][network]['fqdn'] | regex_replace('\..*$', '')}}    {{ stack_host }}_{{ network }}
      {% elif ip_addresses[stack_host][network]['fqdn'] is not defined
         and stack_host_network['add_hostname_to_ip_address'] | default(false) | bool %}
{{ "%-15s" | format(ip_addresses[stack_host][network]['address']) }}    {{ stack_host }}    {{ stack_host }}_{{ network}}
      {% else %}
{{ "%-15s" | format(ip_addresses[stack_host][network]['address']) }}    {{ stack_host }}_{{ network}}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endfor %}

{% if additional_etc_hosts | default([]) | length >= 1 or additional_etc_hosts_for_all_stacks | default([]) | length >= 1 %}
#
# Additional hosts
# ( additional_etc_hosts defines hosts from this stack in LoR)
# ( additional_etc_hosts_for_all_stacks defines for all stacks in LoR )
#
  {% for item in ( additional_etc_hosts | default([]) + additional_etc_hosts_for_all_stacks | default([]) ) | unique %}
    {% for node in item['nodes'] %}
      {% set address = lookup('vars', item['group'])['ip_addresses'][node['name']][node['network']]['address'] %}
{{ "%-15s" | format(address) }}    {{ node['name'] }}
    {% endfor %}
  {% endfor %}
{% endif %}

{% if logs_server_public_networks is defined and logs_server_public_networks | length >= 1 %}
#
# Log servers.
#
  {% for cluster_class in logs_server_public_networks %}
      {% for item in logs_server_public_networks[cluster_class] %}
{{ "%-15s" | format(all_ip_addresses[item['name']][item['network']].address) }}    {{ item['name'] }}       # {{ cluster_class }}
      {% endfor %}
  {% endfor %}
{% endif %}

