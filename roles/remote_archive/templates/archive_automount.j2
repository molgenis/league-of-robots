[Unit]
Description=Automount for {{ item.1 }}
After=network.target

[Automount]
Where=/{{ item.0.local_top_level_mount | regex_replace('\/', '') }}/{{ item.1 }}/{{ item.0.name }}
TimeoutIdleSec=180
DirectoryMode=2750

[Install]
WantedBy=multi-user.target
